<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WalkCal — Calorie & Activity Tracker</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Supabase Client JS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Modern Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        }
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number] {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased selection:bg-brand-500 selection:text-white pb-12">

    <!-- Top Navigation -->
    <header class="w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4v16"/><path d="M17 4v16"/><path d="M19 8H5"/><path d="M19 16H5"/></svg>
                </div>
                <div>
                    <span class="text-lg font-extrabold tracking-tight text-slate-900">Walk<span class="text-brand-600">Cal</span></span>
                    <span class="hidden sm:inline-block ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 border border-slate-200">v2.0</span>
                </div>
            </div>

            <!-- Sync Indicator -->
            <div class="flex items-center gap-2">
                <span id="syncDot" class="w-2 h-2 rounded-full bg-slate-400"></span>
                <span id="syncStatus" class="text-xs font-semibold text-slate-500">Checking cloud...</span>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 pt-8">
        
        <div class="mb-8">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Walking Energy Expenditure</h1>
            <p class="text-sm sm:text-base text-slate-500 mt-1">Calculate active exercise burn and sync sessions to Supabase.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- LEFT: Input Parameters -->
            <section class="lg:col-span-5 bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm shadow-slate-200/50">
                <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100">
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
                        Workout Parameters
                    </h2>
                    <span class="text-xs font-medium text-slate-400">Live Metric Input</span>
                </div>

                <form id="calculatorForm" class="space-y-4">
                    <!-- Steps -->
                    <div>
                        <label for="steps" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Total Steps</label>
                        <div class="relative">
                            <input type="number" id="steps" required min="1" value="6000"
                                class="w-full bg-slate-50/70 hover:bg-slate-50 focus:bg-white text-slate-900 text-sm font-semibold rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 px-3.5 py-2.5 outline-none transition-all">
                            <span class="absolute right-3.5 top-2.5 text-xs font-medium text-slate-400 pointer-events-none">steps</span>
                        </div>
                    </div>

                    <!-- Distance & Duration -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="distance" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Distance</label>
                            <div class="relative">
                                <input type="number" id="distance" required min="0.01" step="0.01" value="4.0"
                                    class="w-full bg-slate-50/70 hover:bg-slate-50 focus:bg-white text-slate-900 text-sm font-semibold rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 px-3.5 py-2.5 outline-none transition-all">
                                <span class="absolute right-3 top-2.5 text-xs font-medium text-slate-400 pointer-events-none">km</span>
                            </div>
                        </div>

                        <div>
                            <label for="duration" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Duration</label>
                            <div class="relative">
                                <input type="number" id="duration" required min="1" value="45"
                                    class="w-full bg-slate-50/70 hover:bg-slate-50 focus:bg-white text-slate-900 text-sm font-semibold rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 px-3.5 py-2.5 outline-none transition-all">
                                <span class="absolute right-3 top-2.5 text-xs font-medium text-slate-400 pointer-events-none">min</span>
                            </div>
                        </div>
                    </div>

                    <!-- Weight & Age -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="weight" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Body Weight</label>
                            <div class="relative">
                                <input type="number" id="weight" required min="1" step="0.1" value="71"
                                    class="w-full bg-slate-50/70 hover:bg-slate-50 focus:bg-white text-slate-900 text-sm font-semibold rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 px-3.5 py-2.5 outline-none transition-all">
                                <span class="absolute right-3 top-2.5 text-xs font-medium text-slate-400 pointer-events-none">kg</span>
                            </div>
                        </div>

                        <div>
                            <label for="age" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Age</label>
                            <div class="relative">
                                <input type="number" id="age" required min="1" value="32"
                                    class="w-full bg-slate-50/70 hover:bg-slate-50 focus:bg-white text-slate-900 text-sm font-semibold rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 px-3.5 py-2.5 outline-none transition-all">
                                <span class="absolute right-3 top-2.5 text-xs font-medium text-slate-400 pointer-events-none">yrs</span>
                            </div>
                        </div>
                    </div>

                    <!-- Gender Buttons -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Biological Sex</label>
                        <div class="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-xl">
                            <button type="button" id="btnGenderWomen" onclick="setGender('women')"
                                class="py-2 text-xs font-bold rounded-lg transition-all bg-white text-slate-900 shadow-sm">
                                Women
                            </button>
                            <button type="button" id="btnGenderMen" onclick="setGender('men')"
                                class="py-2 text-xs font-bold rounded-lg transition-all text-slate-500 hover:text-slate-800">
                                Men
                            </button>
                        </div>
                        <input type="hidden" id="gender" value="women">
                    </div>

                    <div id="errorMessage" class="hidden text-xs text-rose-600 bg-rose-50 border border-rose-100 p-3 rounded-xl font-medium"></div>

                    <button type="submit" id="submitBtn"
                        class="w-full mt-2 bg-slate-900 hover:bg-slate-800 active:scale-[0.99] text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-slate-900/10 flex items-center justify-center gap-2 transition-all cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
                        <span>Calculate & Save Walk</span>
                    </button>
                </form>
            </section>

            <!-- RIGHT: Analysis & Activity Feed -->
            <section class="lg:col-span-7 space-y-6">
                
                <!-- HERO SUMMARY CARD -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm shadow-slate-200/50">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-brand-500 animate-pulse"></span>
                            <h2 class="text-base font-bold text-slate-900">Workout Energy Analysis</h2>
                        </div>
                        <span id="pacePill" class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-100">
                            Brisk Walk
                        </span>
                    </div>

                    <!-- HERO: Net Active Calories (Large & Prominent) -->
                    <div class="mt-6 flex flex-col sm:flex-row sm:items-baseline justify-between gap-4">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-brand-600 block mb-1">
                                Net Active Calories (Exercise Only)
                            </span>
                            <div class="flex items-baseline gap-2">
                                <span class="text-5xl sm:text-6xl font-black text-slate-900 tracking-tight" id="resNetCalories">160</span>
                                <span class="text-xl font-bold text-brand-600">kcal</span>
                            </div>
                            <p class="text-xs text-slate-500 mt-1 max-w-sm">
                                Calorie deficit produced strictly by the walk. Ideal for calorie logging and food trackers.
                            </p>
                        </div>

                        <!-- Subdued Gross Calorie Box -->
                        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200/70 sm:text-right min-w-[170px]">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 block mb-0.5">Gross (Total) Burn</span>
                            <div class="text-xl font-bold text-slate-700">
                                <span id="resGrossCalories">213</span> <span class="text-xs font-semibold text-slate-400">kcal</span>
                            </div>
                            <span class="text-[10px] text-slate-400 block mt-0.5">Incl. <span id="resRestingCalories">53</span> kcal resting burn</span>
                        </div>
                    </div>

                    <!-- Micro Metric Tiles -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-slate-100">
                        <div class="bg-slate-50/80 p-3 rounded-xl border border-slate-100">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Pace</span>
                            <p class="text-base font-bold text-slate-900" id="resPace">11:15 <span class="text-xs font-normal text-slate-500">/km</span></p>
                        </div>
                        <div class="bg-slate-50/80 p-3 rounded-xl border border-slate-100">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Speed</span>
                            <p class="text-base font-bold text-slate-900"><span id="resSpeedKmh">5.3</span> <span class="text-xs font-normal text-slate-500">km/h</span></p>
                        </div>
                        <div class="bg-slate-50/80 p-3 rounded-xl border border-slate-100">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Cadence</span>
                            <p class="text-base font-bold text-slate-900"><span id="resCadence">133</span> <span class="text-xs font-normal text-slate-500">spm</span></p>
                        </div>
                        <div class="bg-slate-50/80 p-3 rounded-xl border border-slate-100">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Intensity</span>
                            <p class="text-base font-bold text-slate-900"><span id="resMet">4.0</span> <span class="text-xs font-normal text-slate-500">MET</span></p>
                        </div>
                    </div>
                </div>

                <!-- ACTIVITY HISTORY -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm shadow-slate-200/50">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <h3 class="text-base font-bold text-slate-900">Activity History</h3>
                            <span id="historyCountBadge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">0 logged</span>
                        </div>
                        <button onclick="clearHistory()" class="text-xs font-semibold text-slate-400 hover:text-rose-500 transition-colors">Clear</button>
                    </div>

                    <div id="historyContainer" class="space-y-2.5">
                        <div class="py-8 text-center text-slate-400 text-sm">No walk history recorded yet.</div>
                    </div>
                </div>

            </section>
        </div>
    </main>

    <script>
        // ==========================================
        // SUPABASE CLIENT INITIALIZATION
        // Normalized URL to prevent endpoint path issues
        // ==========================================
        const rawSupabaseUrl = "https://yvqsllaijzipaihblcbw.supabase.co/rest/v1/";
        const SUPABASE_URL = rawSupabaseUrl.replace(/\/rest\/v1\/?$/, ''); // Cleans to https://yvqsllaijzipaihblcbw.supabase.co
        const SUPABASE_KEY = "sb_publishable_I6WtuC9L9Y4hRk5m2jxgAw_20bjRehu";

        let supabaseClient = null;
        try {
            if (SUPABASE_URL && SUPABASE_KEY) {
                supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
                document.getElementById('syncDot').className = "w-2 h-2 rounded-full bg-emerald-500";
                document.getElementById('syncStatus').textContent = "Supabase Cloud";
            }
        } catch (e) {
            console.warn("Supabase init error, running locally:", e);
            document.getElementById('syncDot').className = "w-2 h-2 rounded-full bg-amber-400";
            document.getElementById('syncStatus').textContent = "Saved Locally";
        }

        function setGender(val) {
            document.getElementById('gender').value = val;
            const btnW = document.getElementById('btnGenderWomen');
            const btnM = document.getElementById('btnGenderMen');

            if (val === 'women') {
                btnW.className = "py-2 text-xs font-bold rounded-lg transition-all bg-white text-slate-900 shadow-sm";
                btnM.className = "py-2 text-xs font-bold rounded-lg transition-all text-slate-500 hover:text-slate-800";
            } else {
                btnM.className = "py-2 text-xs font-bold rounded-lg transition-all bg-white text-slate-900 shadow-sm";
                btnW.className = "py-2 text-xs font-bold rounded-lg transition-all text-slate-500 hover:text-slate-800";
            }
        }

        // ACSM Standard MET table
        function calculateMET(mph) {
            if (mph <= 0) return 1.0;
            if (mph < 2.0) return 2.0;
            if (mph < 2.5) return 2.8 + (mph - 2.0) * ((3.0 - 2.8) / 0.5);
            if (mph < 3.0) return 3.0 + (mph - 2.5) * ((3.5 - 3.0) / 0.5);
            if (mph < 3.5) return 3.5 + (mph - 3.0) * ((4.3 - 3.5) / 0.5);
            if (mph < 4.0) return 4.3 + (mph - 3.5) * ((5.0 - 4.3) / 0.5);
            if (mph < 4.5) return 5.0 + (mph - 4.0) * ((7.0 - 5.0) / 0.5);
            if (mph < 5.0) return 7.0 + (mph - 4.5) * ((8.3 - 7.0) / 0.5);
            return 8.3 + (mph - 5.0) * 1.5;
        }

        document.addEventListener('DOMContentLoaded', () => {
            fetchWalks();
            computeAndDisplay(false);
        });

        document.getElementById('calculatorForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            await computeAndDisplay(true);
        });

        async function computeAndDisplay(shouldSave = true) {
            const errorMsg = document.getElementById('errorMessage');
            errorMsg.classList.add('hidden');

            try {
                const steps = parseInt(document.getElementById('steps').value);
                const distanceKm = parseFloat(document.getElementById('distance').value);
                const durationMin = parseInt(document.getElementById('duration').value);
                const weightKg = parseFloat(document.getElementById('weight').value);

                if (durationMin <= 0 || distanceKm <= 0 || weightKg <= 0) {
                    throw new Error("Duration, distance, and weight must be greater than zero.");
                }

                const durationHours = durationMin / 60;
                const speedKmh = distanceKm / durationHours;
                const speedMph = speedKmh * 0.621371;
                const paceMinPerKm = durationMin / distanceKm;
                const cadence = Math.round(steps / durationMin);
                const met = calculateMET(speedMph);

                const grossCalories = Math.round(met * weightKg * durationHours);
                const netCalories = Math.round((met - 1) * weightKg * durationHours);
                const restingCalories = grossCalories - netCalories;

                const paceMinutes = Math.floor(paceMinPerKm);
                const paceSeconds = Math.round((paceMinPerKm - paceMinutes) * 60);
                const paceStr = `${paceMinutes}:${paceSeconds.toString().padStart(2, '0')}`;

                // Update UI Hero
                document.getElementById('resNetCalories').textContent = netCalories;
                document.getElementById('resGrossCalories').textContent = grossCalories;
                document.getElementById('resRestingCalories').textContent = restingCalories;
                document.getElementById('resPace').innerHTML = `${paceStr} <span class="text-xs font-normal text-slate-500">/km</span>`;
                document.getElementById('resSpeedKmh').textContent = speedKmh.toFixed(1);
                document.getElementById('resCadence').textContent = cadence;
                document.getElementById('resMet').textContent = met.toFixed(1);

                // Update Category badge
                const paceBadge = document.getElementById('pacePill');
                if (speedKmh < 4.0) {
                    paceBadge.textContent = "Leisurely Walk";
                    paceBadge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 border border-slate-200";
                } else if (speedKmh <= 5.8) {
                    paceBadge.textContent = "Brisk Walk";
                    paceBadge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-100";
                } else {
                    paceBadge.textContent = "Power Walk";
                    paceBadge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-100";
                }

                if (shouldSave) {
                    const record = {
                        steps,
                        distance_km: distanceKm,
                        duration_min: durationMin,
                        weight_kg: weightKg,
                        gross_calories: grossCalories,
                        net_calories: netCalories,
                        pace: `${paceStr} /km`,
                        speed_kmh: parseFloat(speedKmh.toFixed(1)),
                        created_at: new Date().toISOString()
                    };
                    await saveWalk(record);
                    await fetchWalks();
                }

            } catch (err) {
                errorMsg.textContent = err.message;
                errorMsg.classList.remove('hidden');
            }
        }

        async function saveWalk(record) {
            if (supabaseClient) {
                const { error } = await supabaseClient.from('walks').insert([record]);
                if (!error) return;
                console.error("Supabase insert error, saving locally:", error.message);
            }

            const localWalks = JSON.parse(localStorage.getItem('walk_history') || '[]');
            localWalks.unshift(record);
            localStorage.setItem('walk_history', JSON.stringify(localWalks.slice(0, 20)));
        }

        async function fetchWalks() {
            let walks = [];

            if (supabaseClient) {
                const { data, error } = await supabaseClient
                    .from('walks')
                    .select('*')
                    .order('created_at', { ascending: false })
                    .limit(10);
                if (!error && data && data.length > 0) {
                    walks = data;
                }
            }

            if (walks.length === 0) {
                walks = JSON.parse(localStorage.getItem('walk_history') || '[]');
            }

            renderHistory(walks);
        }

        function renderHistory(walks) {
            const container = document.getElementById('historyContainer');
            const badge = document.getElementById('historyCountBadge');
            badge.textContent = `${walks.length} logged`;

            if (!walks || walks.length === 0) {
                container.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm">No walk history recorded yet.</div>`;
                return;
            }

            container.innerHTML = walks.map(w => {
                const dateObj = new Date(w.created_at);
                const timeStr = dateObj.toLocaleDateString(undefined, {
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
                });

                return `
                    <div class="flex items-center justify-between p-3.5 bg-slate-50/80 hover:bg-slate-100/90 rounded-xl border border-slate-100 transition-all">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-emerald-100/70 text-brand-700 flex items-center justify-center font-bold text-xs">
                                ${w.distance_km}k
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-slate-900 text-sm">${w.distance_km} km</span>
                                    <span class="text-xs text-slate-400">• in ${w.duration_min}m</span>
                                </div>
                                <span class="text-xs text-slate-400 block">${timeStr} · ${Number(w.steps).toLocaleString()} steps · ${w.pace}</span>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-base font-extrabold text-brand-600">+${Math.round(w.net_calories)}</div>
                            <span class="text-[10px] font-semibold text-slate-400 block uppercase">Net Active</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function clearHistory() {
            localStorage.removeItem('walk_history');
            fetchWalks();
        }
    </script>
</body>
</html>